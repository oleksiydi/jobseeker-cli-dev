{
  "mongodb": {
    "db_name": "jobcenter"
  },
  "collections": {
    "list": "stellenangebote",
    "details": "jobdetails",
    "analysis": "analysen",
    "profiles": "profiles",
    "analysis_prompts": "analysis_prompts"
  },
  "history_collections": {
    "list": "stellenangebote_history",
    "details": "jobdetails_history"
  },
  "history_ttl_days": {
    "list_seen": 540
  },
  "jobcenter": {
    "list_api": {
      "api_url": "https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4/jobs",
      "api_key": "jobboerse-jobsuche",
      "params": {
        "wo": "Regensburg",
        "umkreis": 10,
        "size": "200",
        "pav": false,
        "facetten": false
      },
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Accept-Language": "de,ru-RU;q=0.9,ru;q=0.8,en-US;q=0.7,en;q=0.6,uk;q=0.5",
        "Connection": "keep-alive",
        "Origin": "https://www.arbeitsagentur.de"
      },
      "max_requests": 10000,
      "output_filenames": {
        "job_list": "jobangebote.json",
        "job_details": "stellenangebote.json"
      }
    },
    "details_api": {
      "url_template": "https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v3/jobdetails/{ref_b64}",
      "headers": {
        "X-API-Key": "jobboerse-jobsuche",
        "Accept": "application/json"
      }
    }
  },
  "analyzer": {
    "model": "gpt-5-nano",
    "profile_key": "default",
    "prompt_key": "default",
    "prompt_version": null
  },
  "matching": {
    "enabled": false,
    "run_mode": "nightly",
    "allow_manual_run": true,
    "nightly_schedule_cron": "0 2 * * *",
    "preprocess": {
      "strategy": "spacy_de_trf",
      "version": "v1"
    },
    "chunking": {
      "strategy": "semantic",
      "version": "v1",
      "sentence_splitter": "spacy",
      "spacy_model": "de_core_news_md",
      "semantic_similarity_threshold": 0.72,
      "semantic_sentence_window": 2,
      "semantic_min_sentences": 2,
      "semantic_max_sentences": 14,
      "hard_max_chunk_chars": 2200,
      "hard_min_chunk_chars": 300,
      "fallback_overlap_chars": 120,
      "token_aware_enabled": true,
      "token_splitter": "transformers",
      "tokenizer_model_name": "intfloat/multilingual-e5-large",
      "max_tokens_per_chunk": 320,
      "overlap_tokens": 48
    },
    "embeddings": {
      "model_name": "intfloat/multilingual-e5-large",
      "vector_size": 1024
    },
    "retrieval": {
      "top_k": 100
    },
    "rerank": {
      "enabled": true,
      "model_name": "BAAI/bge-reranker-v2-m3",
      "top_n": 50,
      "weights": {
        "role": 0.4,
        "chunk": 0.3,
        "profile": 0.2,
        "metadata": 0.1,
        "chunk_top1": 0.6,
        "chunk_top2": 0.3,
        "chunk_top3": 0.1,
        "rerank_pre_llm": 0.75,
        "rerank_lexical": 0.25,
        "role_mismatch_threshold": 0.08,
        "role_mismatch_penalty": 0.65
      }
    },
    "selection_cache": {
      "enabled": true,
      "ttl_hours": 24,
      "top_base": 20,
      "extra_min": 5,
      "top_cap": 50
    },
    "llm": {
      "provider_mode": "local",
      "input_mode": "compact",
      "fallback_provider_mode": null
    },
    "qdrant": {
      "url": "http://127.0.0.1:6333",
      "collection_name": "job_chunks_v1",
      "distance": "Cosine",
      "hnsw_m": 16,
      "hnsw_ef_construct": 100,
      "timeout_seconds": 10,
      "max_retries": 2,
      "retry_backoff_seconds": 0.5
    },
    "rules": {
      "enabled": true,
      "ruleset_version": "v1",
      "path": "conf/rules",
      "files": {
        "normalize": "normalize_rules.v1.json",
        "fallback": "fallback_rules.v1.json",
        "label": "label_rules.v1.json",
        "reindex": "reindex_rules.v1.json"
      }
    }
  }
}
