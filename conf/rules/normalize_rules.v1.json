{
  "rule_set_version": "v1",
  "rules": [
    {
      "id": "flag_alt_roles_empty",
      "when": { "==": [ { "var": "alt_roles_count" }, 0 ] },
      "set": { "alt_roles_empty": true },
      "reason": "alt_roles_is_empty_after_cleanup"
    },
    {
      "id": "flag_title_or_role_missing",
      "when": {
        "or": [
          { "==": [ { "var": "title" }, "" ] },
          { "==": [ { "var": "role" }, "" ] }
        ]
      },
      "set": { "title_or_role_missing": true },
      "reason": "title_or_role_missing"
    }
  ]
}
