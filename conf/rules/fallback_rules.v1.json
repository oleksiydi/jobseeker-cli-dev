{
  "rule_set_version": "v1",
  "rules": [
    {
      "id": "fallback_synthetic_chunk_for_missing_description",
      "when": { "==": [ { "var": "description_missing" }, true ] },
      "set": {
        "create_synthetic_chunk": true,
        "description_missing": true
      },
      "reason": "description_missing_use_synthetic_chunk"
    }
  ]
}
