# Максимальная скорость (быстрые smoke/итерации)
# Применение: source conf/presets/matching-speed.env.example

MATCHING_ENABLED=true
MATCHING_CHUNKING_STRATEGY=baseline
MATCHING_TOKEN_AWARE_ENABLED=false
MATCHING_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MATCHING_EMBEDDING_VECTOR_SIZE=384
MATCHING_RETRIEVAL_TOP_K=60
MATCHING_RERANK_TOP_N=20
MATCHING_QDRANT_MAX_RETRIES=1
MATCHING_QDRANT_TIMEOUT_SECONDS=8
