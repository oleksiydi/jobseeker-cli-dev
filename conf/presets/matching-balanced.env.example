# Баланс качество/скорость (рекомендуемый повседневный режим)
# Применение: source conf/presets/matching-balanced.env.example

MATCHING_ENABLED=true
MATCHING_CHUNKING_STRATEGY=semantic
MATCHING_SEMANTIC_MAX_SENTENCES=8
MATCHING_TOKEN_AWARE_ENABLED=true
MATCHING_MAX_TOKENS_PER_CHUNK=300
MATCHING_OVERLAP_TOKENS=40
MATCHING_EMBEDDING_MODEL=intfloat/multilingual-e5-base
MATCHING_EMBEDDING_VECTOR_SIZE=768
MATCHING_RETRIEVAL_TOP_K=80
MATCHING_RERANK_TOP_N=35
MATCHING_QDRANT_MAX_RETRIES=2
MATCHING_QDRANT_TIMEOUT_SECONDS=10
