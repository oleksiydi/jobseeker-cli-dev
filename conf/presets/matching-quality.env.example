# Максимальное качество (nightly / контрольные прогоны)
# Применение: source conf/presets/matching-quality.env.example

MATCHING_ENABLED=true
MATCHING_CHUNKING_STRATEGY=semantic
MATCHING_TOKEN_AWARE_ENABLED=true
MATCHING_MAX_TOKENS_PER_CHUNK=340
MATCHING_OVERLAP_TOKENS=56
MATCHING_EMBEDDING_MODEL=intfloat/multilingual-e5-large
MATCHING_EMBEDDING_VECTOR_SIZE=1024
MATCHING_RETRIEVAL_TOP_K=120
MATCHING_RERANK_TOP_N=60
MATCHING_QDRANT_MAX_RETRIES=2
MATCHING_QDRANT_TIMEOUT_SECONDS=12
