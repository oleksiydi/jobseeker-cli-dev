{
  "esco": {
    "api_url": "https://ec.europa.eu/esco/api",
    "version": "v1.2.1",
    "language": "de",
    "page_size": 100
  },
  "dkz": {
    "base_url": "https://rest.arbeitsagentur.de/infosysbub/download-portal-rest/ct/dkz-downloads/",
    "files": [
      "DKZ_alle_Berufe_gueltig_ungueltig.xml",
      "DKZ_Taetigkeiten_gueltig.xml",
      "DKZ_Kompetenzen_gueltig.xml",
      "DKZ_Suchworte_Kompetenzen_gueltig.xml"
    ]
  },
  "storage": {
    "work_dir": "logs/reference-data",
    "entries_collection": "reference_entries",
    "sources_collection": "reference_sources",
    "files_bucket": "reference_files",
    "batch_size": 500
  },
  "http": {
    "timeout_seconds": 45,
    "max_file_bytes": 33554432
  }
}
