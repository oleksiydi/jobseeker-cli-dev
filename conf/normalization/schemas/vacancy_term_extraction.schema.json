{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VacancyTermExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vacancy_domains",
    "terms"
  ],
  "properties": {
    "vacancy_domains": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "confidence"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "it_software_daten",
              "ingenieurwesen_technik",
              "industrie_produktion_fertigung",
              "handwerk_bau_ausbau",
              "logistik_transport_lager",
              "gesundheitswesen_pflege_medizin",
              "bildung_soziales_erziehung",
              "vertrieb_marketing_kommunikation",
              "finanzen_versicherung_recht",
              "verwaltung_oeffentlicher_dienst",
              "kundenservice_callcenter_buero",
              "einzelhandel_grosshandel",
              "gastgewerbe_tourismus_event",
              "reinigung_sicherheit_facility",
              "sonstiges"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "category",
          "facet",
          "domain_hint",
          "domain_confidence",
          "context_phrase"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "enum": [
              "skills",
              "tools",
              "stack"
            ]
          },
          "facet": {
            "type": "string",
            "enum": [
              "skill_requirement",
              "tool_or_platform",
              "technology_stack",
              "task_responsibility",
              "benefit",
              "work_condition",
              "language_requirement",
              "certification",
              "interpersonal_competency",
              "other"
            ]
          },
          "domain_hint": {
            "type": "string",
            "enum": [
              "it_software_daten",
              "ingenieurwesen_technik",
              "industrie_produktion_fertigung",
              "handwerk_bau_ausbau",
              "logistik_transport_lager",
              "gesundheitswesen_pflege_medizin",
              "bildung_soziales_erziehung",
              "vertrieb_marketing_kommunikation",
              "finanzen_versicherung_recht",
              "verwaltung_oeffentlicher_dienst",
              "kundenservice_callcenter_buero",
              "einzelhandel_grosshandel",
              "gastgewerbe_tourismus_event",
              "reinigung_sicherheit_facility",
              "sonstiges"
            ]
          },
          "domain_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "context_phrase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
