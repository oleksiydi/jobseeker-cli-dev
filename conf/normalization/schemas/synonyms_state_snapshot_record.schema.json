{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynonymsStateSnapshotRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_run_id",
    "exported_at",
    "state_id",
    "alias",
    "alias_key",
    "canonical",
    "domain",
    "category",
    "facet",
    "skill_class",
    "processing_status",
    "decision_source",
    "confidence",
    "source",
    "source_refs_count",
    "sample_phrases",
    "run_id",
    "lease_owner",
    "lease_expires_at",
    "retry_count",
    "last_error",
    "adjudication_policy",
    "adjudication",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "snapshot_run_id": { "type": "string", "minLength": 1 },
    "exported_at": { "type": "string", "minLength": 1 },
    "state_id": { "type": "string", "minLength": 1 },
    "alias": { "type": "string", "minLength": 1 },
    "alias_key": { "type": "string", "minLength": 1 },
    "canonical": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "facet": { "type": "string", "minLength": 1 },
    "skill_class": { "type": "string", "minLength": 1 },
    "processing_status": { "type": "string", "minLength": 1 },
    "decision_source": { "type": "string" },
    "confidence": { "type": ["number", "null"] },
    "source": { "type": "string" },
    "source_refs_count": { "type": ["integer", "null"], "minimum": 0 },
    "sample_phrases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "run_id": { "type": "string" },
    "lease_owner": { "type": ["string", "null"] },
    "lease_expires_at": { "type": ["string", "null"] },
    "retry_count": { "type": ["integer", "null"], "minimum": 0 },
    "last_error": {},
    "adjudication_policy": { "type": "object" },
    "adjudication": { "type": "object" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
