{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynonymsDictionary",
  "description": "Domain-aware synonyms dictionary for release/auto layers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "canonical",
          "domain",
          "category",
          "facet",
          "skill_class",
          "domain_scope",
          "facet_scope"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "canonical": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "skills",
              "tools",
              "stack"
            ]
          },
          "facet": {
            "type": "string",
            "enum": [
              "skill_requirement",
              "tool_or_platform",
              "technology_stack",
              "task_responsibility",
              "benefit",
              "work_condition",
              "language_requirement",
              "certification",
              "interpersonal_competency",
              "other"
            ]
          },
          "skill_class": {
            "type": "string",
            "enum": [
              "professional",
              "interpersonal",
              "non_skill_conditions",
              "not_applicable"
            ]
          },
          "domain_scope": {
            "type": "string",
            "enum": [
              "specific",
              "cross_domain_candidate",
              "global_safe"
            ]
          },
          "facet_scope": {
            "type": "string",
            "enum": [
              "specific",
              "unstable"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_refs_count": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "llm",
              "rule",
              "manual"
            ]
          },
          "updated_at": {
            "type": "string"
          }
        }
      }
    },
    "aliases": {
      "description": "Legacy flat mapping (alias->canonical) kept for backward compatibility during migration.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ambiguous_aliases": {
      "description": "Alias keys that resolve to multiple canonicals and therefore must not be normalized through the global flat index.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
