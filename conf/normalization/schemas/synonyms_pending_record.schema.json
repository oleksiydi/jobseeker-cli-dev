{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynonymsPendingRecord",
  "description": "One candidate synonym link generated from taxonomy aggregate and/or LLM clustering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "alias",
    "canonical",
    "domain",
    "category",
    "facet",
    "skill_class",
    "confidence",
    "source",
    "review_status",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "type": "string",
      "minLength": 1
    },
    "canonical": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "skills",
        "tools",
        "stack"
      ]
    },
    "facet": {
      "type": "string",
      "enum": [
        "skill_requirement",
        "tool_or_platform",
        "technology_stack",
        "task_responsibility",
        "benefit",
        "work_condition",
        "language_requirement",
        "certification",
        "interpersonal_competency",
        "other"
      ]
    },
    "skill_class": {
      "type": "string",
      "enum": [
        "professional",
        "interpersonal",
        "non_skill_conditions",
        "not_applicable"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "llm",
        "rule",
        "manual"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_refs_count",
        "sample_phrases"
      ],
      "properties": {
        "source_refs_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_phrases": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "auto_suggested",
        "approved",
        "rejected"
      ]
    },
    "review_note": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
