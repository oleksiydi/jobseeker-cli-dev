############################################
# Core runtime
############################################
MONGODB_URI=mongodb://root:change_me@localhost:27017/?authSource=admin
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY

############################################
# Docker local stack (docker/docker-compose.yml)
# IMPORTANT: replace all *_PASSWORD values.
############################################
MONGO_IMAGE=mongo:8.0
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_AUTH_DB=admin

MONGO_EXPRESS_IMAGE=mongo-express:1.0.2
MONGO_EXPRESS_BASICAUTH=true
MONGO_EXPRESS_BASICAUTH_USERNAME=admin
MONGO_EXPRESS_BASICAUTH_PASSWORD=change_me

NOSQLCLIENT_IMAGE=mongoclient/mongoclient
METABASE_IMAGE=metabase/metabase:v0.56.6
QDRANT_IMAGE=qdrant/qdrant:v1.17.0
MKDOCS_MATERIAL_IMAGE=squidfunk/mkdocs-material:9.6.20

############################################
# Local LLM (docker/docker-compose.llm.yml)
############################################
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_CPP_HOST_PORT=8081
LLAMA_CPP_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
LLAMA_CPP_CTX_SIZE=4096
LLAMA_CPP_THREADS=4
LLAMA_CPP_BATCH_SIZE=256
LLAMA_CPP_PARALLEL=1

LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://127.0.0.1:8081
LLM_TIMEOUT_SECONDS=60
OPENAI_BASE_URL=https://api.openai.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
# OpenRouter provider routing is neutral by default.
# Set these variables only when you explicitly want routing preferences or provider pinning.
# Examples:
# OPENROUTER_PROVIDER_SORT=throughput
# OPENROUTER_PROVIDER_DATA_COLLECTION=deny
# OPENROUTER_PROVIDER_ZDR=true
# OPENROUTER_PROVIDER_ORDER=deepinfra,weights_and_biases
# OPENROUTER_PROVIDER_ONLY=deepinfra
# optional: allow provider fallback routing
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=false
# optional: preferred provider order (comma-separated OpenRouter provider slugs)
# OPENROUTER_PROVIDER_ORDER=
# optional: restrict to selected providers only (comma-separated OpenRouter provider slugs)
# OPENROUTER_PROVIDER_ONLY=
# for structured output, default true: enforce provider support for requested params
OPENROUTER_REQUIRE_PARAMETERS=true

# Autonomous dictionary: dedicated models, independent of LLM_PROVIDER/LLM_MODEL.
# CLI > these ENV overrides > conf/app.json dictionary_pipeline > code defaults.
# Defaults: paid OpenRouter Mistral Nemo for extraction and first synonyms pass;
# MiMo-V2.6-Flash for disputed synonyms; Pro only when Flash cannot decide.
# Free endpoints are rejected. Unset overrides fall back to config, then defaults.
TAXONOMY_LLM_PROVIDER=openrouter
TAXONOMY_LLM_MODEL=mistralai/mistral-nemo
SYNONYMS_REVIEW_PROVIDER=openrouter
SYNONYMS_REVIEW_MODEL=xiaomi/mimo-v2.6-flash
SYNONYMS_ESCALATION_PROVIDER=openrouter
SYNONYMS_ESCALATION_MODEL=xiaomi/mimo-v2.6-pro
# Resolve unambiguous reference terms locally; LLM sees residual fragments/new synonym links.
# CLI --[no-]reference-first > nonempty ENV > conf/app.json dictionary_pipeline.reference_first > true.
# Empty inherits JSON; true/false, 1/0, yes/no. --no-reference-first restores the full baseline.
# Novel/ambiguous text is retained, long residuals are batched instead of silently truncated.
DICTIONARY_REFERENCE_FIRST=

# ESCO/DKZ reference import: CLI --work-dir > ENV > conf/reference-data.json storage.work_dir.
# Default caches official source files locally; no LLM API key is needed.
REFERENCE_DATA_DIR=logs/reference-data

# Output language: ru/de. Empty ENV inherits JSON; default is ru.
# --output-language > nonempty ENV > selected job-intelligence JSON (unless null)
# > conf/app.json output_language > ru. Collectors use the app JSON fallback.
# To switch collection warnings too, export this variable before starting collectors.
# DE output uses separate de/ directories; source quotes/fields are never translated.
JOBSEEKER_OUTPUT_LANGUAGE=
# Local job intelligence: CLI --model-dir > ENV > <project>/models/embeddings.
# Existing/downloaded MiniLM weights only; no API key or automatic model download.
# Relative paths are resolved from the current working directory; run from repo root.
JOB_INTELLIGENCE_MODEL_DIR=models/embeddings
# Independent experimental requirement -> profile-fact matching (default false).
# --[no-]experimental-skill-matching > nonempty ENV > JSON experimental_skill_matching.enabled > false.
# Requires --profile-file and existing local weights; no Qdrant/LLM/download.
# --vacancies-file runs without Mongo. Outputs .skills.*; main ranking/letters remain unchanged.
# Empty inherits JSON. true/false, 1/0, yes/no are accepted.
JOB_INTELLIGENCE_SKILL_MATCHING=
# Related-skill explanations and German letter additions from active ESCO/DKZ.
# ENV > conf/job-intelligence.json reference_relations.enabled > true; false disables.
JOB_INTELLIGENCE_RELATIONS_ENABLED=true
# Full scan CLI: --all-vacancies ignores candidate_limit; --vacancy-scope defaults
# to latest-run (completed list run), active or all-stored are explicit alternatives.
# --batch-size > conf/job-intelligence.json processing_batch_size > 200 jobs.
# --limit still controls only the top report; every evaluated job goes to .all.csv.
# PDF/RTF: --export-documents enables the full scan and document_export defaults.
# --limit > conf/job-intelligence.json document_export.limit > 50 (allowed 1..2000, shared with regular reports).
# --documents-dir > non-null document_export.output_dir > --output parent / documents.
# output_dir=null (or omitted): --output .../top3/report -> .../top3/documents/YYYY-MM-DD/.
# Output: YYYY-MM-DD/00_Список.pdf + .rtf; 01..50/Оценка.pdf + .rtf + Вакансия.pdf.
# document_export.enabled=false; conversion_timeout_seconds=60 per PDF/RTF.
# Complete JSON/Markdown dossiers without PDF converters: --export-json-md.
# CLI flag > JOB_INTELLIGENCE_EXPORT_JSON_MD > JSON document_export.json_md_enabled > false.
# Accepts true/false, 1/0, yes/no; empty ENV falls back to JSON; invalid value fails before DB access.
# Root shared with PDF/RTF, then json_md/YYYY-MM-DD/01..N: vacancy, letter, assessment, advice.
# Can be combined with --export-documents; one scan, independent daily exports.
JOB_INTELLIGENCE_EXPORT_JSON_MD=false
# German Anschreiben PDF/RTF in each position; cover_letter.enabled=true, max_skills=3.
# Optional private contacts: CLI --application-file > JOB_APPLICATION_FILE > JSON
# document_export.cover_letter.details_file > conf/profiles/application.private.json.
# Empty ENV falls back; explicit missing file fails. Missing default contacts are allowed;
# letters require candidate first/last name, company and position. Other gaps -> Рекомендации.pdf.
JOB_APPLICATION_FILE=
# Requires WeasyPrint/Pango/fonts and Pandoc. No LLM/cloud fallback.

# Learning write gates (opt-in, default false in scripts)
# ALLOW_PROFILE_LEARNING controls tools/update_taxonomy_from_unknown_terms.py writes.
ALLOW_PROFILE_LEARNING=false
# ALLOW_VACANCY_LEARNING controls tools/build_taxonomy_from_vacancies.py writes.
ALLOW_VACANCY_LEARNING=false
# Release policy: keep both flags false during production runs and freeze.

############################################
# Optional overrides (usually keep in conf/app.json)
############################################
JOBCENTER_LIST_API_KEY=jobboerse-jobsuche
JOBCENTER_DETAILS_API_KEY=jobboerse-jobsuche
# Public browser search URL; default empty -> conf/app.json jobcenter.list_api.search_url -> null.
# ENV > JSON > default (no dedicated CLI flag). Empty ENV falls back to JSON.
# URL mode owns geography/filters; only size/facetten defaults come from params.
# Unknown filters, semicolon lists and repeated values pass unchanged. Never paste auth URLs/secrets.
# Homeoffice nv_true differs between browser and API; literal mode emits a warning.
JOBCENTER_SEARCH_URL=
# JSON result_window_limit=10000: equality already means possible truncation.
# search_area.max_plz_per_run=10000 in shipped config; geographic guard, no extra ENV.
# A capped PLZ emits warnings, other shards continue. No automatic splitting by optional filters.
# Optional request jitter overrides. Format: min,max seconds. Use 0 to disable.
# JOBCENTER_REQUEST_JITTER_SECONDS=0.5,3.0
JOBCENTER_LIST_REQUEST_JITTER_SECONDS=0.5,5.0
JOBCENTER_DETAILS_REQUEST_JITTER_SECONDS=0.5,2.0

MONGODB_DB_NAME=jobcenter
COLLECTION_STELLENANGEBOTE=stellenangebote
COLLECTION_JOBDETAILS=jobdetails
COLLECTION_ANALYSEN=analysen
COLLECTION_PROFILES=profiles

# Application evidence: no new ENV; uses the same JOB_INTELLIGENCE_MODEL_DIR above.
# Model path: CLI --model-dir > ENV JOB_INTELLIGENCE_MODEL_DIR > models/embeddings.
# Other CLI defaults (no ENV overrides): --profile-file required;
# --supplement-profile/--usage-policy unset; --vacancies-file conf/application-evidence-demo.json;
# --job-ref unset (all selected, 1..10 jobs); --top-k 3 (1..5);
# --embedding-threads 2 (1..8); --no-embeddings false (explicit baseline);
# --output reports/private/application-evidence/report. Missing model -> error, no download/fallback.
# Mongo references/cache required even for baseline; no generative/external model calls.

# Qwen3.5-2B experiment (no new ENV; CLI > code defaults; cloud ENV is ignored).
# prepare_qwen35_experiment.py: --config conf/experiments/qwen35-2b.json;
# --model-dir models/local-llm/qwen35-2b; --runtime-dir models/local-llm/llama.cpp;
# --work-dir /tmp/jobseeker-llama-build; --build-jobs 2 (1..2).
# app.evidence_llm_experiment defaults:
# --cases-file reports/private/qwen35-experiment/cases.json;
# --profile-file conf/profiles/default.profile.ext.json;
# --supplement-profile conf/profiles/default.profile.json;
# --usage-policy reports/private/application-evidence/usage-policy.json;
# --manifest models/local-llm/qwen35-2b/manifest.json;
# --runtime models/local-llm/llama.cpp/bin/llama-server;
# --output reports/private/qwen35-experiment/run;
# --threads 2 (1..4), --port 18081 (localhost only), --timeout 180s (10..600).
# --case-id unset (all cases), --repeat-controls false. Missing runtime/model -> error;
# never download during inference, redirect, use ENV proxies or fall back to a remote provider.

# Additional local checkpoints (no new ENV; CLI > code defaults).
# tools/prepare_local_model.py: --config required; --model-dir defaults to
# models/local-llm/<normalized-owner-repository>; existing weights/partials are preserved.
# tools/compare_local_models.py: --cases-file required; --run required/repeatable;
# --output required (private .json/.md). Reports must use the same cases/selection.
# Inference CLI above accepts any verified manifest; model_alias comes from it.
