############################################
# Core runtime
############################################
MONGODB_URI=mongodb://root:change_me@localhost:27017/?authSource=admin
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY

############################################
# Docker local stack (docker/docker-compose.yml)
# IMPORTANT: replace all *_PASSWORD values.
############################################
MONGO_IMAGE=mongo:8.0
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_AUTH_DB=admin

MONGO_EXPRESS_IMAGE=mongo-express:1.0.2
MONGO_EXPRESS_BASICAUTH=true
MONGO_EXPRESS_BASICAUTH_USERNAME=admin
MONGO_EXPRESS_BASICAUTH_PASSWORD=change_me

NOSQLCLIENT_IMAGE=mongoclient/mongoclient
METABASE_IMAGE=metabase/metabase:v0.56.6
QDRANT_IMAGE=qdrant/qdrant:v1.17.0
MKDOCS_MATERIAL_IMAGE=squidfunk/mkdocs-material:9.6.20

############################################
# Local LLM (docker/docker-compose.llm.yml)
############################################
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_CPP_HOST_PORT=8081
LLAMA_CPP_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
LLAMA_CPP_CTX_SIZE=4096
LLAMA_CPP_THREADS=4
LLAMA_CPP_BATCH_SIZE=256
LLAMA_CPP_PARALLEL=1

LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://127.0.0.1:8081
LLM_TIMEOUT_SECONDS=60
OPENAI_BASE_URL=https://api.openai.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
# OpenRouter provider routing/privacy defaults used by app/llm/providers/openrouter_api.py
# sort default: price
OPENROUTER_PROVIDER_SORT=price
# data_collection default: deny
OPENROUTER_PROVIDER_DATA_COLLECTION=deny
# zdr default: true (may fail for models without ZDR endpoints; override per run if needed)
OPENROUTER_PROVIDER_ZDR=true
# optional: allow provider fallback routing (unset = provider default behavior)
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=false
# for structured output, default true: enforce provider support for requested params
OPENROUTER_REQUIRE_PARAMETERS=true

# Learning write gates (opt-in, default false in scripts)
# ALLOW_PROFILE_LEARNING controls tools/update_taxonomy_from_unknown_terms.py writes.
ALLOW_PROFILE_LEARNING=false
# ALLOW_VACANCY_LEARNING controls tools/build_taxonomy_from_vacancies.py writes.
ALLOW_VACANCY_LEARNING=false
# Release policy: keep both flags false during production runs and freeze.

############################################
# Optional overrides (usually keep in conf/app.json)
############################################
JOBCENTER_LIST_API_KEY=jobboerse-jobsuche
JOBCENTER_DETAILS_API_KEY=jobboerse-jobsuche

MONGODB_DB_NAME=jobcenter
COLLECTION_STELLENANGEBOTE=stellenangebote
COLLECTION_JOBDETAILS=jobdetails
COLLECTION_ANALYSEN=analysen
COLLECTION_PROFILES=profiles
